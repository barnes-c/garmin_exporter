      "targets": [
        {
          "expr": "100 * max(garmin_wellness_total_steps{instance=~\"$instance\"}) / max(garmin_wellness_step_goal{instance=~\"$instance\"})",
          "legendFormat": "Steps",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
